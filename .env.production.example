# ==============================================================
# SwaggedUp Backend — PRODUCTION environment example
# Copy to .env on your host (Render/Railway dashboard → Environment)
# and fill in real values. NEVER commit the real .env to git.
# ==============================================================

# --- CRITICAL: gates JWT-secret hard-fail, Swagger-off,
# --- the dev OTP 111111 backdoor, and the seeder.
NODE_ENV=production

# Server port (Render injects this automatically)
PORT=3000

# Frontend origins allowed by CORS (comma-separated for www + apex)
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# Used in OTP / order-confirmation email links
FRONTEND_URL=https://yourdomain.com

# --- Generate with: openssl rand -hex 32
# App refuses to boot in production if this is missing.
JWT_SECRET=paste-64-char-random-hex-here

# ===== Database (Oracle MySQL HeatWave) =====
# Use the DB System's standard MySQL endpoint (NOT the HeatWave
# analytics endpoint). Port 3306, classic protocol.
DB_TYPE=mysql
DB_HOST=10.0.1.x                 # private IP if backend runs in same VCN
# DB_HOST=your-db-system....mysql.oraclecloud.com   # public endpoint
DB_PORT=3306
DB_USERNAME=swaggedup_user
DB_PASSWORD=your-db-password
DB_DATABASE=swaggedup
# HeatWave DB Systems enforce TLS by default — required if
# "Require Secure Client Connections" is enabled on the DB System:
# DB_SSL=true

# ===== Seeder =====
# NEVER set to true in production — it would create a
# known-credential admin (admin@swaggedup.com / admin123).
# Seed the prod DB once from your machine instead.
# RUN_SEEDER=true

# ===== Mail (SMTP) — REQUIRED for OTP registration/reset =====
# Without these, OTP emails are silently skipped and
# registration is broken in production.
# Brevo example:
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=your-brevo-login@example.com
MAIL_PASS=your-smtp-key
MAIL_FROM=SwaggedUp <no-reply@yourdomain.com>

# ===== Customer OTP =====
OTP_EXPIRY_MINUTES=10

# ===== Razorpay LIVE keys (swap rzp_test_ → rzp_live_) =====
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-live-key-secret
# Same secret you enter in the Razorpay dashboard webhook config
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ===== WhatsApp Cloud API (optional) =====
WHATSAPP_TOKEN=your-meta-permanent-access-token
WHATSAPP_PHONE_ID=your-meta-phone-number-id
WHATSAPP_BUSINESS_NUMBER=919876543210
