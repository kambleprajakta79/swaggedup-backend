# Environment
NODE_ENV=development

# Server Port
PORT=3000

# CORS - Frontend URL
CORS_ORIGIN=http://localhost:4200

# Authentication
JWT_SECRET=your-jwt-secret-here

# Database configuration
# Set DB_TYPE to 'sqlite' (local dev) or 'mysql' (production)
DB_TYPE=better-sqlite3

# SQLite configuration (default for local dev)
DB_DATABASE=database.sqlite

# MySQL Configuration (Uncomment when DB_TYPE=mysql)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=root
# DB_DATABASE=swaggedup

# Seeder (set to true to force seeding in production)
# RUN_SEEDER=true

# Frontend URL (used in emails / WhatsApp message links)
FRONTEND_URL=http://localhost:4200

# ===== Mail (Brevo SMTP) =====
# Brevo dashboard: SMTP & API → create SMTP key
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=your-brevo-account-email@example.com
MAIL_PASS=your-brevo-smtp-key
MAIL_FROM=SwaggedUp <no-reply@swaggedup.com>

# ===== Customer OTP auth =====
OTP_EXPIRY_MINUTES=10

# ===== Razorpay (test mode keys during development) =====
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# ===== WhatsApp Cloud API (Meta Business) =====
WHATSAPP_TOKEN=your-meta-permanent-access-token
WHATSAPP_PHONE_ID=your-meta-phone-number-id
# Display number used for wa.me click-to-chat links (country code, no +)
WHATSAPP_BUSINESS_NUMBER=919876543210
